# Copy to .env.local for local work. Set the same keys in Cloudflare Pages
# (Settings > Variables, for Production AND Preview).

# Master switch and publisher id (AdSense > Account > Account information)
NEXT_PUBLIC_ADS_ENABLED=false
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-0000000000000000
# "true" serves test ads only (no revenue). Use while reviewing placements.
NEXT_PUBLIC_ADS_TEST_MODE=false

# Display ad unit ids (AdSense > Ads > By ad unit > Display ads).
# Blank = that placement renders nothing.
# every page, above the footer
NEXT_PUBLIC_ADSENSE_SLOT_SITE_FOOTER=
# home, after the game grid
NEXT_PUBLIC_ADSENSE_SLOT_HOME_INLINE=
# /games/, above the grid
NEXT_PUBLIC_ADSENSE_SLOT_CATALOG_TOP=
# /games/, bottom
NEXT_PUBLIC_ADSENSE_SLOT_CATALOG_BOTTOM=
# /games/<slug>/, above the title
NEXT_PUBLIC_ADSENSE_SLOT_GAME_TOP=
# /games/<slug>/, after details
NEXT_PUBLIC_ADSENSE_SLOT_GAME_BOTTOM=

# In-game interstitials via the H5 Games Ad Placement API (needs H5 Games
# Ads enabled on the AdSense account). Breaks fire only at round end.
NEXT_PUBLIC_ADS_GAMES_ENABLED=false
NEXT_PUBLIC_ADS_GAMES_FREQUENCY=60s
