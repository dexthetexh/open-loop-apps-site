# Copy to .env.local for local development. Set the same keys in Cloudflare Pages.
NEXT_PUBLIC_ADS_ENABLED=false
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-0000000000000000
# Real ad unit IDs from AdSense > Ads > By ad unit. Leave blank to render no slot.
NEXT_PUBLIC_ADSENSE_SLOT_CATALOG=
NEXT_PUBLIC_ADSENSE_SLOT_GAME=
# "true" renders test ads (no revenue) during layout work
NEXT_PUBLIC_ADS_TEST_MODE=false
